# Copy to .env and fill in. This file stays local — never commit .env.
ANTHROPIC_API_KEY=
# Used by the Research sub-agent (tools/research_tools.py) for material
# rate/vendor lookups. Without it, search_material_rate/search_vendors
# return an "unavailable" error instead of failing the whole run.
TAVILY_API_KEY=
# Alternative/additional model providers, if used later:
# OPENAI_API_KEY=
# SEARCHAPI_API_KEY=

# Where the local SQLite plan store + checkpointer db lives.
RENOVATOR_DATA_DIR=~/.renovator

# Optional: LangSmith tracing (design doc §4/Phase 9). LangChain reads
# these env vars itself — no code change needed to turn tracing on. Every
# agent run (main + sub-agent calls, tool calls, tokens, latency) shows up
# in the LangSmith UI at https://smith.langchain.com under LANGSMITH_PROJECT.
# Leave LANGSMITH_TRACING unset/false to keep everything fully local (the
# default state this app has run in through Phase 8).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=renovator
